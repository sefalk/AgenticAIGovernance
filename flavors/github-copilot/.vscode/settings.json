// Minimal VS Code settings required for the Agent Framework.
// Projects should extend this with their own settings.
{
    // REQUIRED: enables agent hook scripts (.github/hooks/)
    "chat.useCustomAgentHooks": true,

    // Recommended: enable pytest integration
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "python.testing.unittestEnabled": false,

    // Python type-checking strictness (mirrors PYLANCE_TYPE_CHECKING in af-env.conf).
    // Pylance hard-gate: agents must not suppress pyright errors without justification.
    // Values: off | basic | standard | strict
    "python.analysis.typeCheckingMode": "strict"
}
