# Templates
templates/

# Logs (session-scoped, not committed)
logs/                                                    [optional]

# Retros
retros/                                                  [optional]

# Root-level AF files
MANIFEST.md
GOVERNANCE.md
TOOLS.md
TROUBLESHOOTING.md
copilot-instructions.md                                  [customizable]

# Deployment metadata (managed by deploy script)
.af-manifest
.af-version                                              [optional]

# Per-file attribute overrides (files within directories)
instructions/architecture.instructions.md                [customizable]

# VS Code files (deployed to .vscode/ instead of .github/)
toolsets.jsonc                                           [optional, vscode]
tasks.json                                               [customizable, vscode]
settings.json                                            [customizable, vscode]
