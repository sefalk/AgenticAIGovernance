hooks/scripts/check-large-files.py
hooks/scripts/check-strict-json.py
hooks/scripts/check-scratch-tasks.py
hooks/scripts/check-context-budget-staged.py
hooks/scripts/check-plan-budget.py
hooks/scripts/check-plan-structure.py
hooks/scripts/check-workflow-log.py
hooks/scripts/collect-agent-invocations.py
hooks/git/pre-commit

