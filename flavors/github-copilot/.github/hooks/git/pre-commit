#!/usr/bin/env sh
# Pre-commit guards for the Agent Framework (real git pre-commit hook, not a
# VS Code agent hook). Runs each checker in .github/hooks/scripts and blocks
# `git commit` if any of them fails:
#
#   check-large-files.py  -- staged file exceeds LARGE_FILE_MAX_BYTES from
#                            .github/af-env.conf   (override: ALLOW_LARGE_FILES=1)
#   check-strict-json.py  -- staged .vscode/tasks.json is not strict JSON
#                            (override: ALLOW_JSONC=1)
#   check-context-budget-staged.py
#                         -- staged instruction/agent payload is over the
#                            budgets in .github/af-env.conf; runs only when the
#                            commit touches a measured file
#                            (override: ALLOW_CONTEXT_BUDGET=1)
#   check-plan-budget.py  -- staged plan document exceeds the budget its
#                            complexity tier earns in .github/af-env.conf
#                            (override: ALLOW_PLAN_BUDGET=1)
#   check-plan-structure.py
#                         -- staged plan document has placeholder fields,
#                            invented sections, or subtasks without acceptance
#                            criteria    (override: ALLOW_PLAN_STRUCTURE=1)
#
# Fail-open if a checker or a Python interpreter is missing; the checkers
# themselves are fail-closed on git errors.
#
# Enable once per clone (bootstrap does this):
#   git config core.hooksPath .github/hooks/git
set -u

repo_root="$(git rev-parse --show-toplevel)"

# Resolve the checkers relative to this hook rather than to the repo root: the
# AF source repo keeps the payload under flavors/github-copilot/ and invokes
# this script from its own .githooks/pre-commit.
hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)"
if [ -n "$hook_dir" ] && [ -d "$hook_dir/../scripts" ]; then
    scripts_dir="$hook_dir/../scripts"
else
    scripts_dir="$repo_root/.github/hooks/scripts"
fi

python_bin=""
python_bin_extra_args=""
# A candidate is accepted only if it can actually report a version: on Windows
# `command -v python` answers with the Microsoft Store alias, which then
# refuses to run. Trusting that answer turned every guard into a failure and
# every commit into a block -- a broken interpreter probe is indistinguishable
# from a payload that is genuinely over budget.
try_python() {
    if [ -n "$1" ] && "$1" $2 --version >/dev/null 2>&1; then
        python_bin="$1"
        python_bin_extra_args="$2"
        return 0
    fi
    return 1
}
try_python "$repo_root/.venv/Scripts/python.exe" "" \
    || try_python "$repo_root/.venv/bin/python" "" \
    || try_python python3 "" \
    || try_python python "" \
    || try_python py "-3" \
    || true
if [ -z "$python_bin" ]; then
    echo "[pre-commit] WARN: no python interpreter found -- skipping guards." >&2
    exit 0
fi

status=0
for checker in check-large-files.py check-strict-json.py check-context-budget-staged.py check-plan-budget.py check-plan-structure.py; do
    [ -f "$scripts_dir/$checker" ] || continue  # fail-open if checker missing
    if ! "$python_bin" $python_bin_extra_args "$scripts_dir/$checker"; then
        status=1
    fi
done
exit "$status"
